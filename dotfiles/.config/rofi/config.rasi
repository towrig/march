/* Rofi Configuration - Deep Ocean Theme */
/* Matches Hyprland teal color scheme */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    font: "JetBrainsMono Nerd Font 12";
    drun-display-format: "{name}";
    display-drun: "  Apps";
    display-run: "  Run";
    display-window: "  Windows";
    terminal: "alacritty";
}

@theme "theme"

